generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectTemplate {
  SA_190
  SA_491
  BLANK
}

enum ChecklistStatus {
  NOT_STARTED
  PREPARING
  READY
  SENT
  CONFIRMED
}

enum CollaboratorRole {
  OWNER
  VIEWER
  COLLABORATOR
}

enum ReviewStatus {
  PENDING
  VERIFIED
  REJECTED
  CORRECTED
}

enum ChangeImportance {
  GENERAL
  IMPORTANT
  MAJOR
}

enum FileScanStatus {
  PENDING
  CLEAN
  REJECTED
  ERROR
}

model Account {
  id                  String                @id @default(cuid())
  email               String                @unique
  emailVerifiedAt     DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletionRequestedAt DateTime?
  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  projects            Project[]             @relation("ProjectOwner")
  memberships         Collaborator[]
  shares              ShareLink[]
  auditEvents         AuditEvent[]
  subscription        Subscription?
  sentInvitations     CollaborationInvite[] @relation("InviteSender")
  comments            ProjectComment[]
  uploadedFiles       FileRecord[]          @relation("FileUploader")
  syncOperations      SyncOperation[]
  notificationPreference NotificationPreference?
  notificationOutbox NotificationOutbox[]
}

model Project {
  id                  String                @id @default(cuid())
  ownerId             String
  owner               Account               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  template            ProjectTemplate
  applicantName       String
  targetDate          DateTime?
  cloudFilesEnabled   Boolean               @default(false)
  allowViewerDownload Boolean               @default(false)
  version             Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  checklist           ChecklistItem[]
  files               FileRecord[]
  collaborators       Collaborator[]
  shares              ShareLink[]
  auditEvents         AuditEvent[]
  invitations         CollaborationInvite[]
  comments            ProjectComment[]
  syncOperations      SyncOperation[]

  @@index([ownerId, updatedAt])
}

model CollaborationInvite {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   Account          @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  email       String
  role        CollaboratorRole
  tokenHash   String           @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([projectId, expiresAt])
  @@index([email, expiresAt])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    Account  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
}

model ChecklistItem {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  category   String
  person     String
  status     ChecklistStatus @default(NOT_STARTED)
  dueAt      DateTime?
  reminderAt DateTime?
  note       String?
  sourceUrl  String?
  sourceAsOf DateTime?
  reviewAsOf DateTime?
  position   Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  files      FileRecord[]

  @@index([projectId, position])
}

model FileRecord {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  uploadedById    String?
  uploadedBy      Account?       @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  originalName    String
  storageKey      String
  contentType     String
  byteSize        BigInt
  sha256          String
  compatibility   String
  isOriginal      Boolean        @default(true)
  parentFileId    String?
  scanStatus      FileScanStatus @default(PENDING)
  scannerVersion  String?
  scannedAt       DateTime?
  createdAt       DateTime       @default(now())

  @@unique([projectId, storageKey])
  @@index([checklistItemId])
  @@index([uploadedById])
}

model UploadSession {
  id           String    @id @default(cuid())
  projectId    String
  accountId    String
  storageKey   String    @unique
  originalName String
  contentType  String
  byteSize     BigInt
  sha256       String
  expiresAt    DateTime
  completedAt  DateTime?
  fileId       String?   @unique
  createdAt    DateTime  @default(now())

  @@index([projectId, accountId, expiresAt])
}

model SyncOperation {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payloadHash String
  result      Json
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([accountId, createdAt])
}

model Collaborator {
  id         String           @id @default(cuid())
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role       CollaboratorRole
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())

  @@unique([projectId, accountId])
  @@index([accountId])
}

model ShareLink {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      Account   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  accessCodeHash String
  attempts       Int       @default(0)
  lockedUntil    DateTime?
  allowDownload  Boolean   @default(false)
  scope          Json
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId, expiresAt])
}

model AuditEvent {
  id           String   @id @default(cuid())
  accountId    String?
  account      Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action       String
  targetType   String
  targetId     String?
  safeMetadata Json?
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

model Source {
  id              String         @id @default(cuid())
  name            String
  url             String         @unique
  jurisdiction    String
  sourceType      String         @default("official")
  enabled         Boolean        @default(true)
  licenseNote     String?
  lastCheckedAt   DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  lastFailureCode String?
  snapshots       PageSnapshot[]
  news            NewsItem[]
  changes         ChangeLog[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PageSnapshot {
  id           String   @id @default(cuid())
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  contentHash  String
  snapshotKey  String
  httpStatus   Int
  etag         String?
  lastModified String?
  fetchedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([sourceId, contentHash])
  @@index([sourceId, fetchedAt])
}

model ChangeLog {
  id              String           @id @default(cuid())
  candidateHash   String?
  sourceId        String
  source          Source           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  titleZh         String
  oldExcerpt      String?
  newExcerpt      String?
  context         String?
  importance      ChangeImportance
  reviewStatus    ReviewStatus     @default(PENDING)
  editorSummaryZh String?
  discoveredAt    DateTime
  officialAt      DateTime?
  verifiedAt      DateTime?
  publishedAt     DateTime?
  correctionNote  String?
  tags            String[]         @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([reviewStatus, importance, discoveredAt])
}

model NewsItem {
  id          String   @id @default(cuid())
  sourceId    String
  source      Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  titleZh     String
  summaryZh   String
  sourceTitle String
  /// 官方原文摘录。采集时写入，**编辑永不覆盖**。
  ///
  /// 原先没有这一列，采集器把英文摘录临时塞进 summaryZh；运营写下中文摘要的那一刻
  /// 原文就永久消失了。于是审核页物理上无法把译文和原文并排显示——而我们的硬规则是
  /// 「重要变更必须人工核实后才发布」，核实工具里却没有被核实的那个东西。
  sourceExcerpt String?
  /// 中文编辑稿是谁写的：model（模型起草）/ editor（人工）/ null（还没写）。
  ///
  /// 模型起草过的稿子必须逐字对照原文——它编造过邀请人数，也写出过「建议申请」，
  /// 那两条是校验层拦下的。人写的扫一眼即可。两种审法不同，界面上必须区分得开。
  draftAuthor String?
  sourceUrl   String   @unique
  tags        String[]
  isPublished Boolean  @default(false)
  publishedAt DateTime
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@index([isPublished, publishedAt])
}

model Subscription {
  id                  String    @id @default(cuid())
  accountId           String    @unique
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider            String
  productId           String
  status              String
  originalTransaction String    @unique
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())
}

/// 最小删除证明，不保留邮箱、账号 ID、文件名或材料内容。
model AccountDeletionLedger {
  id          String   @id @default(cuid())
  accountHash String
  requestedAt DateTime
  deletedAt   DateTime @default(now())
  objectCount Int
  status      String   @default("COMPLETED")

  @@index([accountHash, deletedAt])
}

model NotificationPreference {
  accountId      String   @id
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  policyUpdates  Boolean  @default(false)
  productUpdates Boolean  @default(false)
  jurisdictions  String[] @default(["AU-SA"])
  tags           String[] @default([])
  importantOnly  Boolean  @default(true)
  timezone       String   @default("Australia/Adelaide")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NotificationOutbox {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind        String
  entityId    String
  payload     Json
  dedupeKey   String   @unique
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  errorCode   String?
  availableAt DateTime @default(now())
  claimedAt   DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, availableAt])
  @@index([accountId, createdAt])
}

/// 内测登录的失败计数与锁定。
/// 内测访问码逐邮箱绑定，因此暴力猜测只能针对单个邮箱；按邮箱计数即可阻断，
/// 且未注册邮箱同样计数，避免通过响应差异枚举内测名单。
model PilotLoginAttempt {
  email       String    @id
  attempts    Int       @default(0)
  lockedUntil DateTime?
  lastAttempt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

/// 后台管理员账号。
///
/// 放数据库而不是环境变量，是因为环境变量那条路要求「在本机生成哈希 → 粘进服务器
/// .env → 重启 API」：密码要跨机器，哈希要经过命令行（会进 shell 历史），
/// 改一次密码要重启一次服务。而且逗号分隔的配置里**一个格式错误会让所有管理员
/// 一起登不进去**——那是把单点故障做进了鉴权。
///
/// 密码用 scrypt 加逐账号随机盐。这里只存哈希，明文从不落库也不出服务器。
model AdminUser {
  email        String    @id
  passwordHash String
  displayName  String?
  /// 停用而不是删除：审计记录要能指回是谁做的操作。
  disabled     Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
