FROM python:3.13.7-slim
RUN useradd --create-home --uid 10001 crawler
WORKDIR /worker
COPY --chown=crawler:crawler services/crawler ./
COPY --chown=crawler:crawler tools/summarize_drafts.py tools/crosscheck_drafts.py tools/editorial_worker.py /worker/tools/
USER crawler
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "migration_crawler.service"]
