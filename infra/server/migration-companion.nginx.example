# Waymark 的 nginx 反向代理配置。
#
# **这份文件必须与服务器上的 /etc/nginx/sites-enabled/migration-companion 保持一致。**
# 两者曾经分叉过：管理后台的三个 location 和登录限流只加在了服务器上，仓库里一个
# admin 字样都没有——服务器重装就等于后台消失，而且没人知道为什么。
#
# 三个入口：
#   migration-companion-api.<域名>        → API（容器 53101）
#   migration-companion.<域名>            → 公开网页（容器 53103）
#   migration-companion.<域名>/admin/     → 管理后台（容器 53102）
#
# 后台挂在产品域名的路径下而不是独立子域名：少一条 DNS 记录、少一张要续期的证书。
# token 只存页面内存、不进任何存储，同源风险很低；配合 X-Frame-Options: DENY
# 基本封死 iframe 那条路。
#
# 限流区定义在 conf.d/migration-companion-ratelimit.conf（同目录下有一份）。
# HTTPS 由 Certbot 追加：这份示例**故意不含** listen 443 与证书路径，
# 那些是机器相关的，`certbot --nginx` 会自己插入。
#
# 部署时把示例域名替换成真实域名，并保留服务器上已有的其它站点。

server {
    server_name migration-companion-api.infinite-innovation.com;

    # 云文件关闭期间请求体很小；开放云存储后按最大文件调整。

    # 速率限制区定义在 /etc/nginx/conf.d/migration-companion-ratelimit.conf。
    limit_conn mc_conn 20;

    # 内测登录：服务端已按邮箱锁定，这里按来源 IP 挡住换邮箱轮询与洪泛。
    location = /v1/auth/pilot {
        limit_req zone=mc_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:53101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 无账号的分享访问码交换：允许收件人输错几次，但不允许暴力枚举。
    location ~ ^/v1/public/shares/[^/]+/access$ {
        limit_req zone=mc_share burst=10 nodelay;
        proxy_pass http://127.0.0.1:53101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        # App 同步会有突发，用较大的 burst 吸收，正常使用不会触发。
        limit_req zone=mc_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:53101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen [::]:443 ssl; # managed by Certbot

}

server {
    server_name migration-companion.infinite-innovation.com;

    client_max_body_size 2m;

    # 管理后台。挂在产品域名的 /admin/ 下，不单独占子域名——
    # 少一条 DNS 记录、少一张会过期的证书。
    location /admin {
        # 后台没有对外价值，被搜索引擎收录只会招来扫描。
        add_header X-Robots-Tag "noindex, nofollow" always;
        # 控制台上有「发布 / 撤下」按钮，不能允许被任意站点 iframe。
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        proxy_pass http://127.0.0.1:53102;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 后台登录：服务端已按账号锁定（5 次错锁 15 分钟），这里按来源 IP 再挡一层
    # 换账号轮询。复用已有的 mc_login 限流区。
    location = /v1/auth/admin {
        limit_req zone=mc_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:53101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 后台自身要调 API。只放行后台用到的前缀，不把整个 API 复制到网页域名上。
    location /v1/content/admin {
        limit_req zone=mc_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:53101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:53103;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl; # managed by Certbot

}

server {
    if ($host = migration-companion-api.infinite-innovation.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name migration-companion-api.infinite-innovation.com;
    return 404; # managed by Certbot


}

server {
    if ($host = migration-companion.infinite-innovation.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name migration-companion.infinite-innovation.com;
    return 404; # managed by Certbot


}
