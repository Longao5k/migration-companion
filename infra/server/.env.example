POSTGRES_PASSWORD=replace_with_random_value
MINIO_ROOT_USER=migration_storage
MINIO_ROOT_PASSWORD=replace_with_random_value
AWS_ACCESS_KEY_ID=migration_storage
AWS_SECRET_ACCESS_KEY=replace_with_same_minio_password
S3_REGION=ap-southeast-2
S3_USER_BUCKET=migration-user-files

ADMIN_API_KEY=replace_with_random_value
WORKER_API_KEY=replace_with_random_value
# 云文件上传开关。第一阶段初期只做本机存储：材料文件留在用户设备上，服务端不接收新的云文件。
# 付费云存储上线时改为 true，并把用户文件放到澳洲区域的 AWS S3，而不是产品服务器本机。
# 关闭时只挡新增上传；既有文件的下载、删除和分享保持可用。
CLOUD_FILES_ENABLED=false

PILOT_AUTH_ENABLED=true
PILOT_JWT_SECRET=replace_with_at_least_32_random_characters
# 逐邮箱绑定的内测访问码：一个码只能登录它对应的邮箱。共享同一个码会让持码人登录成别人的邮箱。
# 每个内测用户运行一次：pnpm --filter @migration-companion/api pilot:hash-code -- <邮箱> <访问码>
# 多个条目用逗号或换行分隔。
PILOT_ACCESS_CODES=first.tester@example.com=replace_with_output_of_pilot_hash_code

# 网页域名：分享接收页、协作邀请页、隐私政策与条款。
PUBLIC_WEB_URL=https://migration.example.com
# API 域名：App 与网页都从这里调 /v1。网页在浏览器端调用，因此必须出现在 APP_ORIGIN 里。
PUBLIC_API_URL=https://api.migration.example.com
PUBLIC_FILES_URL=https://files.migration.example.com
APP_ORIGIN=https://migration.example.com
# 分享与协作邀请链接的对外地址。变量名必须是 SHARE_ORIGIN——服务端读的就是这个。
# 生产环境缺失时 API 会直接报错，而不是生成指向 localhost 的废链接。
SHARE_ORIGIN=https://migration.example.com
CRAWLER_USER_AGENT=MigrationCompanionMonitor/0.1 (+https://migration.example.com/privacy)
CRAWLER_INTERVAL_SECONDS=21600
NEWS_DISCOVERY_LIMIT=6

API_PORT=53101
ADMIN_PORT=53102
WEB_PORT=53103
MINIO_PORT=59100

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
STORE_MONTHLY_PRODUCT_ID=waymark_premium_monthly
STORE_YEARLY_PRODUCT_ID=waymark_premium_yearly
